{
  "name": "lcars-ui",
  "version": "0.1.2",
  "description": "Frameworkunabhängige Web Components für LCARS-Oberflächen",
  "type": "module",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lcars-ui.js"
    }
  },
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --open /",
    "build": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json",
    "build:showcase": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@storybook/web-components-vite": "10.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljunker/lcars-ui.git"
  }
}
